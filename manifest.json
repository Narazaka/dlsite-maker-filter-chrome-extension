{
    "name": "DLsite フィルター",
    "description": "DLsiteの作品一覧を作者名などでフィルターします",
    "version": "2.1.0",
    "manifest_version": 3,
    "content_scripts": [{
        "matches": ["https://www.dlsite.com/*"],
        "js": ["loadOptions.js", "content.js"]
    }],
    "options_ui": {
        "page": "options.html"
    },
    "permissions": [
        "storage"
    ],
    "browser_specific_settings": {
        "gecko": {
            "id": "{aabe6167-db0f-4f14-93c3-1d369e26c262}",
            "data_collection_permissions": {
                "required": ["none"]
            }
        }
    }
}
